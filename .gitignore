# ---------------------------------------------------------------
# بروفايل المتصفح الثابت: فيه كوكيز وجلسات فيسبوك. ممنوع يترفع.
# Fixed browser profile: contains Facebook cookies / live sessions.
# NEVER commit this.
# ---------------------------------------------------------------
profile/

# مخرجات السحب: فيها أسماء ومعرفات ونصوص مستخدمين حقيقيين
# Scrape output: real users' names, IDs and comment text
dumps/

# لقطات التشخيص: HTML وصور لصفحات مسجّل فيها دخول
# Diagnostics captures: HTML + screenshots of logged-in pages
debug/

# البيئة الافتراضية
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# أسرار محلية
.env
.env.*
!.env.example

# محررات / نظام
.vscode/
.idea/
Thumbs.db
desktop.ini

# Test coverage output
.coverage
.coverage.*
htmlcov/

# قايمة الجروبات الحقيقية: معرفات جروبات (الريبو عام) — groups.example.txt هو اللي بيترفع
# Real scrape targets (group ids; public repo) — groups.example.txt is the committed template
groups.txt

# ذاكرة Claude المنقولة: فيها معرفات جروبات و ID الشيت (الريبو عام)
# Claude project memory copy: holds real group ids and the Sheet id (public repo)
memory/

# مفاتيح وإعدادات خاصة (مفتاح الكتابة، مفتاح الأدمن، معرفات الشيت والسكربت والنشر) — الريبو عام
# Private keys and config (ingest/admin keys, Sheet/script/deployment ids) — public repo
.secrets/

# إعداد clasp (فيه scriptId) وفولدر التجهيز اللي بيتولّد قبل كل push
# clasp project file (holds the scriptId) and the generated push staging folder
apps_script/.clasp.json
apps_script/push/

# إعدادات Claude Code المحلية للجهاز (مش للريبو)
# Machine-local Claude Code settings
.claude/settings.local.json
